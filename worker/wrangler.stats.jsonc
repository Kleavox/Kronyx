{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "stats",
  "main": "src/stats/index.ts",
  "compatibility_date": "2026-06-05",
  "dev": { "port": 8791 },
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kry",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "STATS_RATE_LIMIT",
      "namespace_id": "4102",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "observability": {
    "enabled": true,
  },
  "env": {
    "production": {
      "name": "stats",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "stats.kleavox.xyz", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kry",
          "database_id": "__KRY_D1_ID__",
          "migrations_dir": "migrations",
        },
      ],
      "ratelimits": [
        {
          "name": "STATS_RATE_LIMIT",
          "namespace_id": "4102",
          "simple": { "limit": 10, "period": 60 },
        },
      ],
    },
  },
}

{
  "name": "@krynodes/protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./quorum": {
      "types": "./dist/quorum.d.ts",
      "default": "./dist/quorum.js"
    },
    "./summary": {
